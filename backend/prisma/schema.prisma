// ANAGROCI RCN procurement — Postgres schema.
//
// Design notes that matter when reading this file:
//
// 1. STAGE DATA IS FULLY NORMALIZED. There is no `stageData` JSON column. Each of the 17 stages in
//    @anagroci/contract's stages.ts has its own table, with one column per field. Column names come
//    from `StageField.col` and are generated by packages/contract/scripts/gen-prisma-models.ts;
//    tests/stageMap.schema.test.ts asserts every (model, col) here exists in the Prisma DMMF, so a
//    field added to stages.ts without a migration fails CI rather than silently dropping writes.
//
// 2. EVERY STAGE COLUMN IS `String?`. ReceiptRecord.stageData is Record<string, Record<string,
//    string>> — every value is a string on the wire. Typing these as Decimal breaks round-trip two
//    ways: "9.50" comes back "9.5", and "" vs "0" collapse (8 seeded receipts have NET WT KGS = "").
//    The source workbooks also carry French decimal commas ('44,94'). Typed *Num shadow columns
//    exist alongside, written in the same transaction, for reporting and data-quality checks only.
//
// 3. PRESENCE IS AN EXPLICIT FACT (StageEntry), not "a payload row exists". deriveStatus() tests
//    the presence of stageData[stageId], and the frontend's per-keystroke writes mean a stage can
//    legitimately exist with every field blank. StageEntry reproduces that exactly — including that
//    quirk — so the migration is behaviour-preserving. The quirk is then reported as a
//    `stage_present_but_empty` finding instead of being silently changed.
//
// 4. FK POLICY IS SPLIT, on purpose. Hard FKs only on edges verified 100% clean against the real
//    seed data. Bin, Lot and ledger-4 Origin are deliberately NOT hard-FK'd: the workbooks use
//    disjoint namespaces for two different physical sites (Bouaké's BKE-00x vs Yakro's BIN-0xx /
//    ANAGROCI-01), and hard-FKing them would mean inventing a mapping or dropping real rows. They
//    are strings plus a nullable resolved id, with orphans reported by /api/data-quality.
//
// 5. NO `Lot` ENTITY YET. The receipts' LOT-2026NNNN values are fabricated by tools/extract-seed.py
//    and share zero keys with the drying jobs or ledger 4. Building an entity on invented keys
//    would bake in a guess; lot uniqueness lives as a partial unique index on the n-lot stage row.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Masters ───────────────────────────────────────────────────────────────
// Seeded as the union of everything observed in the workbooks, annotated with provenance — not a
// curated whitelist. Dropping an unmatched row would be discarding real client data.

model Supplier {
  code   String  @id
  name   String
  /// Where this code was first observed, e.g. "seed/suppliers.json" or a workbook name.
  source String?

  juteMovements JuteWarehouseMovement[]
}

model Warehouse {
  name   String  @id
  source String?

  receipts      Receipt[]
  juteMovements JuteWarehouseMovement[]
  transfersOut  JuteWarehouseTransferReceipt[]
  aliases       WarehouseAlias[]
}

/// Bin.warehouseName stays NULL where the source data doesn't say — the real workbooks never map
/// bin -> warehouse, and inventing that mapping is exactly what ground rule §4 forbids.
model Bin {
  code          String  @id
  warehouseName String?
  source        String?
}

model Origin {
  name     String    @id
  source   String?
  receipts Receipt[]
}

/// One workbook calls the Yakro factory warehouse "ANAGROCI-01". That is an inference (from the
/// file name "Drying Report_Factory warehouse.xlsx" and the sheet "FINAL DRY RCN-YAKRO-2026"),
/// NOT something the client stated — so it is recorded with provenance and surfaced by
/// /api/data-quality for confirmation, never applied silently.
model WarehouseAlias {
  alias         String    @id
  warehouseName String
  warehouse     Warehouse @relation(fields: [warehouseName], references: [name])
  source        String
  /// "stated" | "inferred" — inferred aliases are reported for client confirmation.
  provenance    String
}

// ── Core entity ───────────────────────────────────────────────────────────
// One truck = one Receipt = one Lot, always (confirmed client rule). Note there are no lotNo /
// binNo columns here: they live on the n-lot / n-bin stage rows and are projected onto the wire
// shape by the assembler. Keeping a second copy here is what forced the old stage-field sync block.

model Receipt {
  id     String @id
  source String /// "imported" | "entered"

  arrivalDate  String
  supplierName String
  lbaCode      String
  vehicleNo    String

  warehouse    String
  warehouseRef Warehouse @relation(fields: [warehouse], references: [name])
  origin       String?
  originRef    Origin?   @relation(fields: [origin], references: [name])

  /// Read-only shadow of the pre-normalization JSON, kept for exactly one release so the
  /// round-trip tests have a live oracle and a rollback path. Dropped in the Phase 8 migration.
  stageDataShadow String?

  stageEntries StageEntry[]
  branches     ReceiptBranch[]
  timeline     TimelineEntry[]

  delplan         StageDeliveryPlan?
  gate            StageGateEntry?
  verify          StageVerifyDocs?
  qfs             StageQualityQfs?
  gross           StageGrossWeight?
  lot             StageLotAssignment?
  bin             StageBinAllocation?
  unload          StageUnload?
  tare            StageTareWeight?
  netwt           StageNetWeight?
  grn             StageGrn?
  stock           StageStockUpdate?
  drying          StageDryingDecision?
  otherActivities OtherActivity[]
  activityLedger  ActivityLedgerEntry[]
  xferdec         StageTransferDecision?
  reject          StageRejection?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warehouse])
  @@index([supplierName])
  @@index([arrivalDate])
  /// Backs the excel-import dedup heuristic (vehicleNo + arrivalDate + supplierName) — the
  /// receipts importer has no natural unique key from the source sheet, so this triple is checked
  /// on every uploaded row and needs to not be a table scan.
  @@index([vehicleNo])
}

/// The single source of truth for "has this receipt reached this stage?" — the only thing
/// deriveStatus() reads. See header note 3.
model StageEntry {
  receiptId String
  stageId   String
  startedAt DateTime @default(now())
  receipt   Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@id([receiptId, stageId])
  @@index([stageId])
}

/// Replaces the old `branches` JSON column. One row per decision taken (n-qfs, n-drying, n-xferdec).
model ReceiptBranch {
  receiptId String
  stageId   String
  branchId  String
  decidedAt DateTime @default(now())
  receipt   Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@id([receiptId, stageId])
}

/// Backs ReceiptRecord.timeline. `at` is a string because the seed carries bare dates
/// ("2026-02-17") while live writes carry full ISO timestamps — normalizing would rewrite
/// real imported values.
model TimelineEntry {
  id        Int     @id @default(autoincrement())
  receiptId String
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  status    String
  at        String
  note      String?

  @@index([receiptId])
}

/// Scoped to a specific Lot/quantity, never a whole Bin (confirmed rule — a Bin mixes Lots).
/// lotNo is a soft reference: real drying history references Lots from before this system existed,
/// and the drying-job lot namespace shares zero keys with the receipts' (see header note 5).
model DryingJob {
  id          String @id
  date        String
  warehouse   String
  bin         String
  lotNo       String
  ficheNo     String
  status      String
  dryType     String
  destination String

  /// The confirmed drying sequence: moisture before -> issue Lot/qty -> dry -> moisture after ->
  /// return to warehouse -> store in a new Bin marked as dried stock, Lot traceability retained.
  moistureBefore   String?
  moistureAfter    String?
  quantityIssued   String?
  quantityReturned String?
  driedStockBin    String?
  /// The Lot this dried stock still traces back to, after it moves to driedStockBin.
  originLotNo      String?

  @@index([lotNo])
  @@index([bin])
}

// ── Per-stage tables ──────────────────────────────────────────────────────
// GENERATED by packages/contract/scripts/gen-prisma-models.ts from stages.ts. Re-run that
// script after changing stages.ts; tests/stageMap.schema.test.ts enforces agreement.

/// Stage n-delplan (gap) — Create delivery plan (expected arrivals)
model StageDeliveryPlan {
  receiptId              String  @id
  supplierSource         String? /// Supplier / source
  expectedQtyOrTruckType String? /// Expected quantity or truck type
  expectedArrivalDate    String? /// Expected arrival date
  destinationWarehouse   String? /// Destination warehouse
  plannedStatus          String? /// Status (planned)
  receipt                Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-gate (entry) — Truck arrives at warehouse (Gate entry)
/// Source: Rcn_Offloading_Details_2026.xlsx · OFFLOADINGS · 28 columns
model StageGateEntry {
  receiptId     String  @id
  sn            String? /// S N
  dateOfArrival String? /// DATE OF ARRIVAL
  rmFg          String? /// RM/FG
  creditCash    String? /// CREDIT/CASH
  whLocation    String? /// WH LOCATION
  whNo          String? /// WH NO.
  vehicleNo     String? /// VEHICLE NO.
  warehouseType String? /// Warehouse type (Village/Regional/Factory)
  receipt       Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-verify (entry) — Verify supplier documents
/// Source: Rcn_Offloading_Details_2026.xlsx · OFFLOADINGS · 28 columns
model StageVerifyDocs {
  receiptId     String  @id
  suppliersName String? /// SUPPLIERS NAME
  lbaCode       String? /// LBA CODE
  ficheCode     String? /// FICHE CODE
  ref           String? /// REF.
  fiche         String? /// FICHE
  origin        String? /// ORIGIN
  receipt       Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-qfs (decision) — Quality analysis (QFS)
/// Source: Rcn_Offloading_Details_2026.xlsx · OFFLOADINGS · 28 columns
model StageQualityQfs {
  receiptId   String   @id
  moisture    String? /// MOIS. (moisture)
  nutCount    String? /// NUT COUNT
  kor         String? /// KOR
  finalKor    String? /// FINAL KOR
  moistureNum Decimal? /// typed shadow of moisture, for reporting/DQ only — never round-tripped
  nutCountNum Decimal? /// typed shadow of nutCount, for reporting/DQ only — never round-tripped
  korNum      Decimal? /// typed shadow of kor, for reporting/DQ only — never round-tripped
  finalKorNum Decimal? /// typed shadow of finalKor, for reporting/DQ only — never round-tripped
  receipt     Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-gross (entry) — Weight truck (Gross weight)
/// Source: Rcn_Offloading_Details_2026.xlsx · OFFLOADINGS · 28 columns
model StageGrossWeight {
  receiptId     String   @id
  grossWtKgs    String? /// GROSS WT KGS
  grossWtKgsNum Decimal? /// typed shadow of grossWtKgs, for reporting/DQ only — never round-tripped
  receipt       Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-lot (gap) — Assign Lot Number to truck
model StageLotAssignment {
  receiptId      String  @id
  lotNumber      String? /// Lot Number
  truckReference String? /// Truck reference
  assignedBy     String? /// Assigned by (Warehouse Team)
  assignedAt     String? /// Date/time assigned
  receipt        Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-bin (gap) — Allocate Bin (physical storage location)
model StageBinAllocation {
  receiptId        String  @id
  binNumber        String? /// Bin Number
  linkedLotNumbers String? /// Linked Lot Number(s)
  allocationBasis  String? /// Basis for allocation (moisture / quality / KOR / space)
  finalisedWhen    String? /// Finalised (same day / next day)
  receipt          Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-unload (entry) — Unload RCN at warehouse
/// Source: Rcn_Offloading_Details_2026.xlsx · OFFLOADINGS · 28 columns
model StageUnload {
  receiptId           String   @id
  dateOfOffloading    String? /// DATE OF OFFLOADING
  sacs                String? /// SACS (bags)
  bonSacs             String? /// BON SACS (good bags)
  humidSacs           String? /// HUMID SACS (damp bags)
  sacsDechires        String? /// Sacs déchirés (torn bags)
  refraction          String? /// Refraction
  manpowerContractor  String? /// Manpower contractor / team
  tallyClerkBagCount  String? /// Tally Clerk bag count
  palletsUsed         String? /// Pallets used (30 bags/pallet)
  forkliftDestination String? /// Forklift destination (Warehouse team decision)
  sacsNum             Decimal? /// typed shadow of sacs, for reporting/DQ only — never round-tripped
  bonSacsNum          Decimal? /// typed shadow of bonSacs, for reporting/DQ only — never round-tripped
  humidSacsNum        Decimal? /// typed shadow of humidSacs, for reporting/DQ only — never round-tripped
  sacsDechiresNum     Decimal? /// typed shadow of sacsDechires, for reporting/DQ only — never round-tripped
  refractionNum       Decimal? /// typed shadow of refraction, for reporting/DQ only — never round-tripped
  receipt             Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-tare (entry) — Weigh truck (Empty – Tare weight)
model StageTareWeight {
  receiptId    String   @id
  tareWtKgs    String? /// Tare / empty truck weight (kg)
  tareWtKgsNum Decimal? /// typed shadow of tareWtKgs, for reporting/DQ only — never round-tripped
  receipt      Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-netwt (system) — Calculate net weight
/// Source: Rcn_Offloading_Details_2026.xlsx · OFFLOADINGS · 28 columns
model StageNetWeight {
  receiptId   String   @id
  netWtKgs    String? /// NET WT KGS
  paidWt      String? /// PAID WT
  netWtKgsNum Decimal? /// typed shadow of netWtKgs, for reporting/DQ only — never round-tripped
  paidWtNum   Decimal? /// typed shadow of paidWt, for reporting/DQ only — never round-tripped
  receipt     Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-grn (entry) — Generate RCN reception record (GRN)
/// Source: Rcn_Offloading_Details_2026.xlsx · OFFLOADINGS · 28 columns
model StageGrn {
  receiptId    String   @id
  price        String? /// PRICE
  amount       String? /// AMOUNT
  grnWeight    String? /// GRN Weight (kept separate from Gross/Net/Paid)
  priceNum     Decimal? /// typed shadow of price, for reporting/DQ only — never round-tripped
  amountNum    Decimal? /// typed shadow of amount, for reporting/DQ only — never round-tripped
  grnWeightNum Decimal? /// typed shadow of grnWeight, for reporting/DQ only — never round-tripped
  receipt      Receipt  @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-stock (system) — Update warehouse RCN stock (System)
model StageStockUpdate {
  receiptId           String  @id
  stockLedgerEntry    String? /// Warehouse stock ledger entry
  warehouseType       String? /// Warehouse type (Village/Regional/Factory)
  currentStockBalance String? /// Current stock balance
  receipt             Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-drying (decision) — Does this truck/lot need drying?
model StageDryingDecision {
  receiptId            String  @id
  decision             String? /// Decision (Direct to drying / Warehouse → Drying)
  moistureBefore       String? /// Moisture % — before drying
  lotQtyIssued         String? /// Lot/quantity identified & issued for drying
  moistureAfter        String? /// Moisture % — after drying
  driedQtyReturned     String? /// Dried quantity returned to warehouse
  driedStockBin        String? /// New/assigned Bin (marked "dried stock")
  traceabilityRetained String? /// Original Lot/truck traceability retained
  receipt              Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-otheract (gap) — Other warehouse activities
model OtherActivity {
  id                       String  @id @default(uuid())
  receiptId                String
  seq                      Int /// order within the receipt; the assembler projects the highest seq into stageData
  rebagging                String? /// Re-bagging (damaged/torn bags)
  destacking               String? /// Destacking
  triage                   String? /// Triage (quality + quantity + moisture check)
  movementBetweenLocations String? /// Movement between locations
  linkedStockLot           String? /// Linked stock/lot
  linkedLocation           String? /// Linked location
  receipt                  Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@unique([receiptId, seq])
  @@index([receiptId])
}

/// Stage n-ledger (gap) — Activity ledger (sequence of record)
model ActivityLedgerEntry {
  id           String  @id @default(uuid())
  receiptId    String
  seq          Int /// order within the receipt; the assembler projects the highest seq into stageData
  activityType String? /// Activity type (discharge, weight, reconditioning, destacking, drying, triage, sèches)
  occurredAt   String? /// Date/time
  quantity     String? /// Quantity
  location     String? /// Location
  linkedLotBin String? /// Linked Lot/Bin
  performedBy  String? /// Performed by
  receipt      Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@unique([receiptId, seq])
  @@index([receiptId])
}

/// Stage n-xferdec (decision) — Transfer to central / factory warehouse?
model StageTransferDecision {
  receiptId String  @id
  decision  String? /// Decision (Stays / Transfers)
  drivenBy  String? /// Driven by (space at warehouse)
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

/// Stage n-reject (gap) — Reject / Hold and inform procurement in charge
model StageRejection {
  receiptId  String  @id
  reason     String? /// Reason for rejection
  statusNote String? /// Status = Rejected (record retained)
  receipt    Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

// ── Jute bag ledgers ──────────────────────────────────────────────────────
// Four separate but linked ledgers. Every movement must trace to Warehouse -> Supplier/Department
// -> Activity -> Quantity -> Movement Type -> Responsible Person/Team -> Date, and link back to the
// Truck/Lot/RCN delivery where applicable — hence real FKs on the edges that are provably clean.
//
// The reconciliation rule (opening + receipts + transfers in − issues − damaged/discarded −
// transfers out = closing) is NOT a stored column anywhere. It is computed by the SQL views
// created in this migration; see backend/src/domain/juteBalance.ts. A stored running balance is
// precisely the drift those views exist to prevent.

/// Ledger 1 — warehouse-level stock. 298 real rows from BOUAKE WAREHOUSE JUTE BAGS MOVEMENT
/// REPORT.xlsx -> JUTE BAGS ISSUED.
model JuteWarehouseMovement {
  id       String @id @default(uuid())
  /// Dense 1..N import order. This, not `sn`, is the ordering key: the sheet's S N column has
  /// duplicates (99-108 repeat) so it cannot identify a row.
  seq      Int    @unique
  /// The sheet's own S N value, kept verbatim. Not unique — see `seq`.
  sn       Int?
  /// The physical row this came from in the workbook, for traceability back to the source.
  sheetRow Int?

  movementDate DateTime?
  /// The raw cell value when it wasn't a real date — the column is mixed-type (287 datetimes and
  /// 11 hand-typed DD-MM-YYYY strings). Preserved rather than coerced.
  rawDate      String?

  /// Overloaded in the source: sometimes a process category, sometimes a supplier name. Kept raw;
  /// `activityCategory` is our derived reading of it, and the overloading is reported by
  /// /api/data-quality rather than cleaned away.
  activitiesType   String
  activityCategory String?

  supplierCode String?
  supplier     Supplier? @relation(fields: [supplierCode], references: [code])

  whLocation String
  warehouse  Warehouse @relation(fields: [whLocation], references: [name])

  truckNumber  String?
  wrNo         String?
  /// Exactly one of these is set on every one of the 298 real rows.
  bagsIssued   Int?
  bagsReceived Int?

  /// The workbook's own BALANCE, stored verbatim and never written by the app. It genuinely goes
  /// negative from S N 195 down to −11,027; the view compares it against the computed running
  /// balance and reports any divergence instead of correcting either one.
  reportedBalance Int?

  /// Gap columns — no workbook captures a good/damaged/repairable split today.
  goodBagsAvailable Int?
  completelyDamaged Int?
  damagedRepairable Int?

  /// Links a bag movement back to the RCN delivery that caused it, where known.
  receiptId String?

  createdAt DateTime @default(now())

  @@index([whLocation, seq])
  @@index([supplierCode])
  @@index([receiptId])
}

/// Ledger 2 — supplier-level movement. Intentionally created empty: every column is a gap, and the
/// only source is an undated hand tally, so seeding rows would mean fabricating dates and
/// transaction ids. The real figures live in JuteTallySnapshot.
model JuteSupplierMovement {
  id String @id @default(uuid())

  movementDate DateTime?
  supplierCode String
  whLocation   String?

  bagsIssuedToSupplier  Int?
  returnedViaDeliveries Int?
  pendingWithSupplier   Int?
  damaged               Int?
  reusable              Int?

  /// Traceability required by the clarification: activity, who did it, and the linked delivery.
  activity         String?
  movementType     String?
  responsibleParty String?
  receiptId        String?
  lotNo            String?

  createdAt DateTime @default(now())

  @@index([supplierCode])
  @@index([receiptId])
}

/// Ledger 3 — factory/production tracking. Also created empty, same reason as ledger 2.
/// Production itself is out of scope; this table only tracks bags issued TO production.
model JuteProductionMovement {
  id String @id @default(uuid())

  movementDate DateTime?
  whLocation   String?
  department   String?

  issuedToProduction  Int?
  goodBagsRecovered   Int?
  completelyDamaged   Int?
  partiallyDamaged    Int?
  returnedToWarehouse Int?
  closingBalance      Int?

  activity         String?
  movementType     String?
  responsibleParty String?

  createdAt DateTime @default(now())

  @@index([whLocation])
}

/// Ledger 4 — warehouse-to-warehouse movement. 367 real rows from BOUAKE RCN RECEIVING at
/// Yamoussoukro as on 9.9.2026.xlsx -> Bouake Stock Reciving.
///
/// The sheet has 34 columns; juteBags.ts models 12 of them for the UI form. All 34 are stored here
/// so normalization doesn't silently discard 22 columns of real client data — the extra 22 are
/// import-and-report only in v1 (not round-tripped through the ledger form).
model JuteWarehouseTransferReceipt {
  id String @id @default(uuid())
  /// 1..367, no duplicates in the source — unlike ledger 1's S N.
  sn Int    @unique

  receivedDate DateTime?
  rawDate      String?
  month        String?
  dryUndry     String?
  idTransfer   String?

  truckRegistration String?
  lotNo             String?
  lotDry            String?
  noFiche           String?
  ccaFicheNumber    String?
  binNo             String?

  damagedBags Int?
  newBagsUsed Int?
  recondition Int?

  /// Constant "BOUAKE" across all 367 rows — every transfer in the data is Bouaké -> Yamoussoukro.
  sourceWarehouse    String
  sourceWarehouseRef Warehouse @relation(fields: [sourceWarehouse], references: [name])
  /// The RCN's upstream supply town (MANKONO, NIAKARA, ...), NOT a warehouse. Soft reference: 7 of
  /// these are absent from the origins master, including a literal 'Not Mentiond '.
  origin             String?

  bagsDispatched          Int?
  bagsReceived            Int?
  /// The real, meaningful difference column (= received − dispatched on all 367 rows; 123 negative).
  reportedDifference      Int?
  /// Empty in all 459 rows of the sheet — a template column nobody fills. Kept so its emptiness is
  /// a reportable fact rather than an assumption.
  finalBagsAfterRebagging Int?
  /// The broken twin of reportedDifference: equals −(Received Bags) on all 367 rows. Stored
  /// verbatim and flagged by the view; deliberately NOT a generated column, which would enshrine
  /// the bug, and deliberately not dropped, which would lose real data.
  reportedDiff            Int?

  laissePasserEntree     String?
  fullyLoadedTruckWeight Int?
  emptyTruckTareWeight   Int?
  grossWeightReceived    Int?
  netWeightAtArrival     Int?
  netWeightDispatched    Int?
  weightDifference       Int?

  /// Mixed-type in the source (365 floats, 1 comma-decimal string, 1 int). The *Raw twin keeps the
  /// original cell text so '44,94' isn't silently reinterpreted.
  korReceived           Decimal?
  korReceivedRaw        String?
  korDispatched         Decimal?
  korDispatchedRaw      String?
  moistureReceived      Decimal?
  moistureReceivedRaw   String?
  moistureDispatched    Decimal?
  moistureDispatchedRaw String?

  ncArrival String?
  comment   String?

  createdAt DateTime @default(now())

  @@index([sourceWarehouse, sn])
  @@index([lotNo])
  @@index([binNo])
}

/// The undated hand-tallied figures that are the ONLY source for ledgers 2 and 3 today. Stored as
/// labelled snapshots rather than invented ledger rows — capturedAt is null because the source
/// carries no date, and that absence is itself the finding.
model JuteTallySnapshot {
  id         String    @id @default(uuid())
  ledgerId   String
  label      String
  value      Int
  source     String
  sheet      String?
  capturedAt DateTime?

  @@unique([ledgerId, label])
}
