// ── Production ───────────────────────────────────────────────────────────────
//
// Design notes specific to Production (see packages/contract/CLAUDE.md's Production section for
// the full spec-side rationale):
//
// 1. TWO SPINES, ONE PIVOT. RCN arrives against a BTM (Bordereau de Transfer — the warehouse's
//    transfer slip) and is tracked by BTM+Bin through intake/quality/calibration. At Cooking the
//    batch becomes a Lot, and everything from Cooking through Packing is tracked by Lot. Bin is the
//    pivot both spines share: a BtmIntake names exactly one destination Bin (verified: 0/104
//    violations in the real "1. RCN Receipts.xlsx"), and a Lot belongs to exactly one Bin (verified:
//    0/107 in "6. Cooking Process Report.xlsx") — but a Bin holds many BTMs and many Lots, never
//    the reverse. ProductionBin -> ProductionLot and ProductionBin -> BtmIntake are the only two
//    hard FKs in this section for exactly that reason; every other production table references its
//    BTM/Lot/Bin as a soft, indexed string (see note 3).
//
// 2. EVERY PRODUCTION TABLE IS "MANY", NOT "ONE" — a correction made against the real data, not an
//    assumption. The obvious reading (one Cooking row per Lot, one BTM-receipt row per BTM) is
//    false: 6. Cooking Process Report has 108 rows across 107 distinct Lots (one Lot was cooked
//    twice), 1. RCN Receipts has 7 BTMs with more than one line (a BTM can draw RCN from more than
//    one source bin, so it gets more than one intake line — matching the real Bordereau de
//    Transfer's own header+lines shape, see flow-xl-map/BTM - Issue to Production.docx). Treating
//    any of these as a hard 1:1 keyed on the natural BTM/Lot number would mean the second real row
//    either fails a unique constraint or silently overwrites the first. So every one of the 22
//    tables below gets its own uuid PK plus a soft, indexed link column — generated by
//    packages/contract/scripts/gen-production-prisma-models.ts from PRODUCTION_FIELD_MAP, same
//    split as procurement's per-stage tables (hand-maintained core entities + relations here,
//    generated field lists pasted in).
//
// 3. FK POLICY, SAME RULE AS PROCUREMENT'S. Hard FKs only on edges verified 100% clean (see note
//    1). Every other btmNo/lotNo/binNo column across the 22 generated tables is the row's own real
//    workbook column doubling as a soft link (nullable, indexed, no FK constraint) — several of
//    those real columns are themselves known-unreliable (2. Input RCN Quality report's own "Lot
//    No" column actually holds Source Bin values, matching procurement's lot_namespace_conflict
//    pattern; 5. Calibrated RCN Silos Stock report's "Batch No"/"BIN No" columns are shifted —
//    both stored verbatim, both reported by /api/data-quality, neither coerced).
//
// 4. STOCK IS A VIEW, NOT A TABLE. "3. RCN Stock Report.xlsx" and its silo equivalent are running
//    balances (opening + received − issued = closing) — computed by SQL views
//    (production_bin_stock, production_silo_stock, added in a hand-written migration mirroring
//    jute_warehouse_movement_balance), never stored, so there is no column that can drift from the
//    receipts/issues it is computed from.

/// The production twin of the Bin master, seeded as the union of every BIN No observed across the
/// 22 production tables — same "observed union, not a curated whitelist" pattern as Bin/Warehouse.
/// Deliberately its OWN model, not a reuse of procurement's Bin: procurement's BKE-x/ANAGROCI-01
/// bin codes are a disjoint namespace from production's ANA-x/BIN-0xx codes (see
/// bin_not_in_master / production_source_bin_spelling_drift) — merging them would either invent a
/// cross-namespace mapping or silently conflate two different physical things named similarly.
model ProductionBin {
  binNo  String  @id
  source String?

  btmIntakes BtmIntake[]
  lots       ProductionLot[]
}

/// Created at Cooking, never before (n-cook is where a batch first gets a Lot Number — see
/// productionStages.ts). lotNo is the real, workbook-transcribed value (e.g. "ANG26E01"), not
/// app-generated — unlike procurement's receipts, which get a server-assigned id before a Lot is
/// even known.
model ProductionLot {
  lotNo  String        @id
  binNo  String
  bin    ProductionBin @relation(fields: [binNo], references: [binNo])
  source String?

  createdAt DateTime @default(now())

  @@index([binNo])
}

/// The Bordereau de Transfer's header (see flow-xl-map/BTM - Issue to Production.docx) — Document
/// No, From/To Location, Issue Purpose, Vehicle No, Time of Dispatch, signatures. No workbook in
/// the 21-file set captures this header directly (only its number, btmNo, appears — as a column on
/// every one of BtmReceipt/BtmInputQuality/CalibrationRun/BtmTallyRow's real lines), so every field
/// below besides btmNo/binNo is a gap: modelled because the real paper form has it, not fabricated.
model BtmIntake {
  btmNo String        @id
  /// Destination production bin — hard FK, verified 100% clean (0/104 violations: every BTM in
  /// the real "1. RCN Receipts.xlsx" lands in exactly one bin, even the 7 BTMs with multiple
  /// source-bin lines). Application-assigned from the first BtmReceipt line written for this BTM;
  /// see services/production/btm.ts's assertOneBinPerBtm.
  binNo String
  bin   ProductionBin @relation(fields: [binNo], references: [binNo])

  /// Below: the Bordereau de Transfer's own header fields. All gap — no real source today.
  documentNo           String?
  fromLocation         String?
  toLocation           String?
  productionLine       String?
  issuePurpose         String?
  vehicleNo            String?
  timeOfDispatch       String?
  preparedByWarehouse  String?
  checkedByQa          String?
  receivedByProduction String?

  source    String?
  createdAt DateTime @default(now())

  @@index([binNo])
}

