# Copy to .env.prod (never commit that file) and fill in real values. See DEPLOY.md.

# Database
POSTGRES_USER=anagroci
POSTGRES_DB=anagroci
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Public host Traefik routes to this stack
DOMAIN=pjs.agilemorph.in

# The first admin account, created by the seeder only while no admin exists. REQUIRED: without a
# password no account exists and nobody can sign in. Change it after the first sign-in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-too
