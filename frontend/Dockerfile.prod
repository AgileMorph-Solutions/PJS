# Production image: builds the SPA, then serves it (and proxies /api) with an nginx that never
# runs as root. Not internet-facing itself — the host's shared Traefik instance terminates TLS
# and forwards plain HTTP here; see docker-compose.prod.yml and deploy/nginx/nginx.prod.conf.
#
# Build context is the REPO ROOT (same reason as frontend/Dockerfile: the app depends on the
# @anagroci/contract workspace package).
FROM node:20-slim AS build
WORKDIR /app

COPY package.json ./
COPY packages/contract/package.json ./packages/contract/
COPY frontend/package.json ./frontend/
# Lockfile deliberately not copied — see frontend/Dockerfile's comment (rolldown's native
# binding is platform-specific and a lockfile from another OS omits the linux one).
# --before pins resolution to the last build known to work (2026-10-13). Without a lockfile, a fresh
# resolve picks up newer releases that trip an npm 10.x arborist bug ("reading 'edgesOut'"); the old
# Docker cache had been hiding that. Move the date forward only after a scratch build proves it.
RUN npm install --before=2026-10-13 --no-audit --no-fund

COPY packages/contract/ ./packages/contract/
COPY frontend/ ./frontend/
RUN npm -w frontend run build

# nginxinc/nginx-unprivileged: master and workers both run as the built-in `nginx` (uid 101)
# user, and listen on 8080 instead of 80 — no root, no capabilities, anywhere in this container.
FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY --from=build /app/frontend/dist /usr/share/nginx/html
COPY deploy/nginx/nginx.prod.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
